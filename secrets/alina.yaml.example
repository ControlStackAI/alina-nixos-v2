# ALINA v2 secrets — EXAMPLE FILE (not encrypted, not real values)
#
# 1. Copy to secrets/alina.yaml
# 2. Fill in real values
# 3. Encrypt with sops:
#      sops --age <AGE_PUBLIC_KEY> --encrypt --in-place secrets/alina.yaml
# 4. Commit the encrypted file (never the plaintext)
#
# The encrypted_regex in .sops.yaml controls which keys get encrypted.
# Keys matching ^(data|stringData|password|secret|token)$ are encrypted.

# OpenClaw Gateway token (from `openclaw gateway token` or dashboard)
token: "PLACEHOLDER_OPENCLAW_GATEWAY_TOKEN"

# ALINA Comms service API key
secret: "PLACEHOLDER_COMMS_API_KEY"

# PostgreSQL init script to set the comms role password
# This is passed as PostgreSQL's initialScript (raw SQL)
password: "ALTER ROLE comms WITH PASSWORD 'PLACEHOLDER_POSTGRES_COMMS_PASSWORD';"

# Additional API keys (add as needed)
# openai_api_key: "sk-..."
# anthropic_api_key: "sk-ant-..."
